/* ---------- Inventory Grid (Weyland-Yutani Theme) ---------- */
.inventory-grid-wrap {
    width: 1200px;
    height: 1000px;
    padding: 12px;
    /* #0D1610 [Screen Background] */
    background-color: rgba(13, 22, 16, 0.85);
    border-width: 2px;
    /* #4A6B5C [Functional Accent] */
    border-color: rgba(74, 107, 92, 0.5);
}

.inventory-grid-viewport {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
}

.inventory-slot {
    width: 128px;
    height: 128px;
    margin: 6px;
    /* #1C2621 [Industrial Hardware] */
    background-color: rgba(28, 38, 33, 0.65);
    border-width: 1px;
    /* #4A6B5C [Functional Accent] */
    border-color: rgba(74, 107, 92, 0.4);
    justify-content: center;
    align-items: center;
    position: relative;
    transition-property: border-color, background-color;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}

.inventory-slot-empty {
    /* #4A6B5C [Functional Accent] */
    border-color: rgba(74, 107, 92, 0.15);
    /* #0D1610 [Screen Background] */
    background-color: rgba(13, 22, 16, 0.4);
}

.inventory-slot-filled:hover {
    /* #33FF33 [Phosphor Green] */
    border-color: rgba(51, 255, 51, 0.8);
    /* #4A6B5C [Functional Accent] */
    background-color: rgba(74, 107, 92, 0.6);
}

.inventory-slot-held {
    /* #33FF33 [Phosphor Green] */
    border-color: rgba(51, 255, 51, 0.95);
    border-width: 2px;
    border-style: dashed;
    /* #1C2621 [Industrial Hardware] */
    background-color: rgba(28, 38, 33, 0.9);
}

.inventory-slot-label {
    /* #33FF33 [Phosphor Green] */
    color: rgba(51, 255, 51, 0.85);
    font-size: 16px;
    -unity-text-align: middle-center;
    letter-spacing: 20px;
    white-space: normal;
    padding-left: 1px;
    padding-right: 1px;
    width: 100%;
}

.inventory-slot-module .inventory-slot-label {
    /* #DAA520 [Data Interface / Status] */
    color: rgba(218, 165, 32, 0.9);
    font-size: 11px;
}

.inventory-slot-tier-badge {
    position: absolute;
    top: 2px;
    left: 2px;
    font-size: 9px;
    /* #DAA520 [Data Interface / Status] */
    color: rgba(218, 165, 32, 0.9);
    /* #0D1610 [Screen Background] */
    background-color: rgba(13, 22, 16, 0.8);
    padding-left: 3px;
    padding-right: 3px;
}

.inventory-slot-count-badge {
    position: absolute;
    bottom: 2px;
    right: 3px;
    font-size: 14px;
    /* #33FF33 [Phosphor Green] */
    color: rgb(51, 255, 51);
    -unity-font-style: bold;
}

.inventory-slot-module-badge {
    position: absolute;
    bottom: 2px;
    left: 3px;
    font-size: 8px;
    /* #CC0000 [Corporate Alert / Warning] */
    color: rgba(204, 0, 0, 0.8);
    letter-spacing: 1px;
}

.inventory-grid-footer {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

.inventory-grid-capacity-label {
    /* #4A6B5C [Functional Accent] */
    color: rgba(74, 107, 92, 0.8);
    font-size: 14px;
    letter-spacing: 1px;
}