/* ---------- Inventory Grid ---------- */
.inventory-grid-wrap {
    width: 1200px;
    height: 1000px;
    padding: 12px;
    background-color: rgba(20, 14, 8, 0.55);
    border-width: 1px;
    border-color: rgba(255, 160, 0, 0.3);
}

.inventory-grid-viewport {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
}

.inventory-slot {
    width: 128px;
    height: 128px;
    margin: 6px;
    background-color: rgba(40, 28, 16, 0.55);
    border-width: 1px;
    border-color: rgba(255, 160, 0, 0.25);
    justify-content: center;
    align-items: center;
    position: relative;
    transition-property: border-color, background-color;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}

.inventory-slot-empty {
    border-color: rgba(255, 160, 0, 0.12);
    background-color: rgba(20, 14, 8, 0.3);
}

.inventory-slot-filled:hover {
    border-color: rgba(255, 200, 120, 0.8);
    background-color: rgba(80, 50, 20, 0.6);
}

.inventory-slot-held {
    border-color: rgba(255, 200, 120, 0.95);
    border-width: 2px;
    border-style: dashed;
    background-color: rgba(80, 50, 20, 0.75);
}

.inventory-slot-label {
    color: rgba(255, 160, 0, 0.85);
    font-size: 10px;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    white-space: normal;
    padding-left: 1px;
    padding-right: 1px;
    width: 100%;
}

.inventory-slot-module .inventory-slot-label {
    color: rgba(255, 220, 170, 0.9);
    font-size: 11px;
}

.inventory-slot-tier-badge {
    position: absolute;
    top: 2px;
    left: 2px;
    font-size: 9px;
    color: rgba(255, 200, 150, 0.9);
    background-color: rgba(0, 0, 0, 0.4);
    padding-left: 3px;
    padding-right: 3px;
}

.inventory-slot-count-badge {
    position: absolute;
    bottom: 2px;
    right: 3px;
    font-size: 12px;
    color: rgb(255, 220, 170);
    -unity-font-style: bold;
}

.inventory-slot-module-badge {
    position: absolute;
    bottom: 2px;
    left: 3px;
    font-size: 8px;
    color: rgba(255, 160, 0, 0.7);
    letter-spacing: 1px;
}

.inventory-grid-footer {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

.inventory-grid-capacity-label {
    color: rgba(255, 160, 0, 0.7);
    font-size: 14px;
    letter-spacing: 1px;
}
