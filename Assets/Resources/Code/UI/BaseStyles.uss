.screen-overlay-wrap {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    padding-right: 40px;
}

.visor-overlay-column {
    width: 400px;
    height: 60%;
    justify-content: space-between;
    align-items: flex-start;
    padding-left: 20px;
    padding-right: 0;
    border-left-width: 1px;
    border-color: rgba(255, 160, 0, 0.25);
}

.status-message-container {
    width: 100%;
}

.status-message-label {
    color: rgba(255, 160, 0, 0.8);
    font-size: 24px;
    margin-top: 4px;
}

.main-deck-row {
    flex-direction: row;
    width: 100%;
    height: 85%;
    align-items: center;
    justify-content: flex-start;
    margin-top: 20px;
    margin-bottom: 20px;
}

.calibration-track {
    width: 65px;
    height: 100%;
    background-color: rgba(186, 143, 69, 0.361);
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: rgba(255, 160, 0, 0.3);
    position: relative;
}

.sweet-zone-element {
    position: absolute;
    width: 100%;
    height: auto;
    background-color: rgba(156, 127, 114, 0.686);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(255, 160, 0, 0.75);
}

.frequency-indicator {
    position: absolute;
    width: 100%;
    height: 10px;
    left: 0;
    background-color: rgb(245, 110, 0);
    margin-top: -5px;
    border-width: 2px;
    border-color: rgb(255, 200, 150);
}

.direction-labels {
    height: 100%;
    justify-content: space-between;
    padding-left: 14px;
    opacity: 0.55;
}

.direction-label {
    color: rgba(255, 160, 0, 0.9);
    font-size: 20px;
}

.direction-label-center {
    color: rgba(255, 255, 255, 0.9);
}

/* ---------- Tool Inventory Carousel ---------- */

.tool-inventory-wrap {
    width: 300px;
    height: 420px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    position: relative;
}

.tool-inventory-viewport {
    width: 100%;
    height: 100%;
    justify-content: flex-start;
    align-items: center;
    position: relative;
}

.tool-box {
    width: 250px;
    height: 84px;
    margin-bottom: 12px;
    background-color: rgba(40, 28, 16, 0.55);
    border-width: 1px;
    border-color: rgba(255, 160, 0, 0.35);
    justify-content: center;
    align-items: center;
    position: absolute;
    left: 15px;
    transition-property: translate, opacity, border-color, background-color;
    transition-duration: 180ms;
    transition-timing-function: ease-out;
}

.tool-box-label {
    color: rgba(255, 160, 0, 0.8);
    font-size: 18px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.tool-box-selected {
    border-color: rgba(255, 200, 120, 0.95);
    border-width: 2px;
    background-color: rgba(80, 50, 20, 0.7);
}

    .tool-box-selected .tool-box-label {
        color: rgb(255, 220, 170);
    }

.tool-box-dist-1 {
    opacity: 0.55;
}

.tool-box-dist-2 {
    opacity: 0.22;
}

.tool-inventory-empty-label {
    color: rgba(255, 160, 0, 0.5);
    font-size: 16px;
    -unity-text-align: middle-center;
}
